{
  "info": {
    "name": "Team Expense Approval & Management System API",
    "description": "Complete production REST API collection for Team Expense Approval & Management System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "1. Login (Employee)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"employee@company.com\",\n  \"password\": \"Employee123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "2. Login (Manager)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"manager@company.com\",\n  \"password\": \"Manager123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "3. Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@company.com\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "4. Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alex\",\n  \"lastName\": \"Morgan\",\n  \"email\": \"alex.morgan@company.com\",\n  \"password\": \"Password123!\",\n  \"department\": \"Engineering\",\n  \"jobTitle\": \"Software Engineer\",\n  \"role\": \"EMPLOYEE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "5. Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Expenses",
      "item": [
        {
          "name": "Submit Expense",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Client Strategy Lunch", "type": "text" },
                { "key": "description", "value": "Quarterly review with stakeholders", "type": "text" },
                { "key": "categoryId", "value": "1", "type": "text" },
                { "key": "amount", "value": "78.50", "type": "text" },
                { "key": "currency", "value": "USD", "type": "text" },
                { "key": "expenseDate", "value": "2026-11-18", "type": "text" },
                { "key": "paymentMethod", "value": "PERSONAL_CREDIT_CARD", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/expenses",
              "host": ["{{baseUrl}}"],
              "path": ["expenses"]
            }
          }
        },
        {
          "name": "Get My Expenses (Paginated & Filtered)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/expenses/my?page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["expenses", "my"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Get Expense By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/expenses/1",
              "host": ["{{baseUrl}}"],
              "path": ["expenses", "1"]
            }
          }
        },
        {
          "name": "Get Expense Status History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/expenses/1/history",
              "host": ["{{baseUrl}}"],
              "path": ["expenses", "1", "history"]
            }
          }
        },
        {
          "name": "Cancel Pending Expense",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/expenses/1/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["expenses", "1", "cancel"]
            }
          }
        }
      ]
    },
    {
      "name": "Approvals Workflow",
      "item": [
        {
          "name": "Get Pending Approvals (Manager)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/approvals/pending",
              "host": ["{{baseUrl}}"],
              "path": ["approvals", "pending"]
            }
          }
        },
        {
          "name": "Approve Expense",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"APPROVED\",\n  \"comments\": \"Itemized receipt verified and approved.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/approvals/1/review",
              "host": ["{{baseUrl}}"],
              "path": ["approvals", "1", "review"]
            }
          }
        },
        {
          "name": "Reject Expense",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"REJECTED\",\n  \"comments\": \"Missing client attendee documentation. Please re-submit with receipt.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/approvals/1/review",
              "host": ["{{baseUrl}}"],
              "path": ["approvals", "1", "review"]
            }
          }
        }
      ]
    },
    {
      "name": "Dashboards & Reports",
      "item": [
        {
          "name": "Employee Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/employee",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "employee"]
            }
          }
        },
        {
          "name": "Manager Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/manager",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "manager"]
            }
          }
        },
        {
          "name": "Admin Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard/admin",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard", "admin"]
            }
          }
        },
        {
          "name": "Filtered Report Summary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/summary",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "summary"]
            }
          }
        },
        {
          "name": "Export Report to CSV",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/export/csv",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "export", "csv"]
            }
          }
        }
      ]
    }
  ]
}
